# Ollama Configuration Environment Variables
# Edit this file to change Ollama settings without modifying the plist

# Network binding - change to 127.0.0.1:11434 for localhost-only access
OLLAMA_HOST="0.0.0.0:11434"

# Performance settings
OLLAMA_NUM_PARALLEL="8"
OLLAMA_KEEP_ALIVE="30m"
OLLAMA_FLASH_ATTENTION="true"
OLLAMA_MAX_LOADED_MODELS="4"
OLLAMA_NOPRUNE="true"

# Add any additional Ollama environment variables here
# See: https://github.com/ollama/ollama/blob/main/docs/configuration.md
